[Unit]
Description=Lightpanda headless browser CDP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lightpanda
Group=lightpanda
WorkingDirectory=/var/lib/lightpanda
StateDirectory=lightpanda
Environment=HOME=/var/lib/lightpanda
ExecStart=/usr/local/bin/lightpanda serve --host 127.0.0.1 --port 9222
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
